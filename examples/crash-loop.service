# Fails on purpose, a second after every start. Nothing here asks for a
# restart: the defaults restart a failed service, with a delay that grows from
# a second to a minute (1 s, 2.3 s, 5.1 s, ...). `stewardctl status crash-loop`
# shows the restart count and when the next one is due.

[Unit]
Description=Exits with code 3 a second after it starts

[Service]
ExecStart=cmd.exe /d /s /c "ping -n 2 127.0.0.1 >nul & exit 3"

[Install]
WantedBy=default.target
