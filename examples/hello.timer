# A timer: every minute, on the minute, it starts hello.service, the service
# named as it is (Unit= would name another). `stewardctl list-timers` shows when
# it next elapses and when it last did; `stewardctl logs -f hello` shows each
# run's line. A nightly job would say `OnCalendar=*-*-* 03:00` and
# `Persistent=true`, so that a night spent signed out is made up at sign-in.

[Unit]
Description=Says hello every minute

[Timer]
OnCalendar=minutely

[Install]
WantedBy=timers.target
